# Local development uses an on-disk SQLite file and requires no Turso account
# or auth token. For Turso Cloud, replace the URL and set TURSO_AUTH_TOKEN.
# Leave the URL blank to use the generated preview catalog instead.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Absolute URL used for canonical Open Graph metadata. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NUXT_PUBLIC_BASE_URL=

# Point the Playwright suite at an already-running dev server.
PLAYWRIGHT_BASE_URL=

# Seed knobs (pnpm db:seed-authors / db:seed-books). Paths default to the
# newline-delimited dumps under server/lib/db. Totals drive progress estimates
# and checkpoint reporting; each input file is processed to the end.
AUTHORS_DATA_PATH=
BOOKS_DATA_PATH=
AUTHORS_CHECKPOINT_PATH=
BOOKS_CHECKPOINT_PATH=
TOTAL_AUTHORS=
TOTAL_BOOKS=
